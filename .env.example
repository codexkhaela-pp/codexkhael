# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Supabase public keys (frontend, optional in current auth flow)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional: enable auth debug logs in non-production too (1 = enabled)
AUTH_DEBUG="0"

# Internal cron authentication secret for keepalive endpoint
CRON_SECRET="bbMV9YrusR69gnJgQwbb6euc021e277rdmYeNghlOzX49JgmsS"

# Ollama local/remote AI server
# Para cambiar de servidor o modelo no hay que tocar codigo:
# OLLAMA_BASE_URL=https://api-ia.codexkhael.com
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_ENABLED=true
# En desarrollo permite probar /api/ai/tarot-local y /api/ai/tarot-spread-local sin sesion si vale "true".
# Nunca tiene efecto fuera de NODE_ENV=development.
OLLAMA_BASE_URL="http://192.168.18.227:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_ENABLED="true"
ALLOW_DEV_AI_TEST="true"
