generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  ADMIN
  TAROTIST
  STUDENT
  CLIENT
}

enum PermissionCode {
  BITACORA_CREATE
  BITACORA_VIEW
  TIRADA_CREATE
  TIRADA_VIEW
  COSTOS_VIEW
  USERS_MANAGE
  PLANS_MANAGE
}

enum PlanType {
  FREE
  MONTHLY
  YEARLY
  ONE_TIME
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model User {
  id              String              @id @default(uuid()) @db.Uuid
  name            String?
  email           String              @unique
  passwordHash    String?
  status          UserStatus          @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  roles           UserRole[]
  bitacoraEntries BitacoraEntry[]
  reReadings      BitacoraReReading[]
  subscriptions   UserSubscription[]

  @@index([email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        PermissionCode   @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  plans       PlanPermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model BitacoraEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  spreadType  String
  question    String   @db.Text
  readingDate DateTime
  readingTime String?
  notes       String?  @db.Text
  cardsJson   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  reReadings BitacoraReReading[]

  @@index([userId])
  @@index([createdAt])
}

model BitacoraReReading {
  id                String   @id @default(uuid()) @db.Uuid
  bitacoraEntryId   String   @db.Uuid
  userId            String   @db.Uuid
  fulfilled         Boolean?
  comment           String?  @db.Text
  reflection        String?  @db.Text
  newInterpretation String?  @db.Text
  lessonLearned     String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bitacoraEntry BitacoraEntry @relation(fields: [bitacoraEntryId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bitacoraEntryId])
}

model Plan {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  price     Decimal    @default(0) @db.Decimal(10, 2)
  currency  String     @default("USD")
  type      PlanType   @default(FREE)
  status    PlanStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  permissions   PlanPermission[]
  limits        PlanLimit[]
  subscriptions UserSubscription[]
}

model PlanPermission {
  planId       String @db.Uuid
  permissionId String @db.Uuid

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([planId, permissionId])
}

model PlanLimit {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  code      String
  value     Int
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model UserSubscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  planId    String             @db.Uuid
  startDate DateTime           @default(now())
  endDate   DateTime?
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
}
