generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  ADMIN
  TAROTIST
  STUDENT
  CLIENT
}

enum PermissionCode {
  BITACORA_CREATE
  BITACORA_VIEW
  TIRADA_CREATE
  TIRADA_VIEW
  COSTOS_VIEW
  USERS_MANAGE
  PLANS_MANAGE
}

/// Commercial tier — what the user can DO
enum PlanTier {
  FREE
  BASIC
  PRO
}

/// How the user pays — billing cycle (used in Plan model & subscriptions)
enum BillingType {
  MONTHLY
  YEARLY
  ONE_TIME
}

/// Legacy: kept for Plan model backward compatibility
enum PlanType {
  FREE
  BASIC
  PRO
  MONTHLY
  YEARLY
  ONE_TIME
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum CardOrientation {
  UPRIGHT
  REVERSED
}

enum DailyJournalStatus {
  EMPTY
  PARTIAL
  COMPLETED
}

enum LearningQuizMode {
  IMAGE_TO_MEANING
  MEANING_TO_CARD
  MIXED
}

enum LearningQuizQuestionType {
  IMAGE_TO_MEANING
  MEANING_TO_CARD
}

enum LearningDeckScope {
  FULL_DECK
  MAJOR_ARCANA
  MINOR_ARCANA
  WANDS
  CUPS
  SWORDS
  PENTACLES
  COURT
  CUSTOM
}

enum LearningOrientationScope {
  UPRIGHT_ONLY
  REVERSED_ONLY
  BOTH
}

enum XpSourceType {
  CHALLENGE_COMPLETED
  QUIZ_COMPLETED
  COURSE_LESSON_COMPLETED
  JOURNAL_ENTRY_CREATED
  STREAK_BONUS
  MANUAL_ADJUSTMENT
}

enum ChallengeType {
  DAILY
  GUIDED
  COMPLETE_CARD
  ERROR_DETECTION
  VEIL_READING
  HARD_DECISION
}

enum ChallengeAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String?
  email             String                 @unique
  passwordHash      String?
  sessionToken      String?
  status            UserStatus             @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  roles             UserRole[]
  bitacoraEntries   BitacoraEntry[]
  reReadings        BitacoraReReading[]
  subscriptions     UserSubscription[]
  accessLogs        AccessLog[]
  resetTokens       PasswordResetToken[]
  profile           UserProfile?
  learningSessions  LearningQuizSession[]
  learningProgress  CardLearningProgress[]
  xpTransactions    UserXpTransaction[]
  challengeAttempts UserChallengeAttempt[]
  challenges        Challenge[]
  usageLogs         UsageLog[]
  cartasDelDia      CartaDelDia[]
  reflexionesDia    ReflexionCartaDia[]
  dailyJournalEntries DailyJournalEntry[]

  @@index([email])
}

model UserProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  displayName    String?
  sexo           String?
  avatarType     String?
  level          Int       @default(1)
  learningStreak Int       @default(0)
  totalXp        Int       @default(0)
  currentLevel   Int       @default(1)
  currentStreak  Int       @default(0)
  bestStreak     Int       @default(0)
  lastStreakDate DateTime?
  timezone       String    @default("America/Lima")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Plan & usage tracking
  userPlan          PlanTier     @default(FREE)
  billingType       BillingType?
  planStartedAt     DateTime?
  planExpiresAt     DateTime?
  dailyAiCount      Int          @default(0)
  lastAiReset       DateTime?
  dailyReadingCount Int          @default(0)
  lastReadingReset  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LevelConfig {
  id              String   @id @default(uuid()) @db.Uuid
  level           Int      @unique
  requiredTotalXp Int
  title           String
  description     String   @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, level])
}

model UserXpTransaction {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  sourceType XpSourceType
  sourceId   String?
  xpAmount   Int
  reason     String?      @db.Text
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model Challenge {
  id           String        @id @default(uuid()) @db.Uuid
  type         ChallengeType
  title        String
  description  String        @db.Text
  difficulty   String
  baseXp       Int
  isDaily      Boolean       @default(false)
  isRepeatable Boolean       @default(true)
  maxDailyXp   Int?
  activeFrom   DateTime?
  activeTo     DateTime?
  isActive     Boolean       @default(true)
  userId       String?       @db.Uuid
  fechaLocal   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions ChallengeQuestion[]
  attempts  UserChallengeAttempt[]

  @@index([isActive, type])
  @@index([isDaily, isActive])
  @@index([userId, fechaLocal])
}

model ChallengeQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  challengeId   String   @db.Uuid
  cardsJson     Json
  questionText  String   @db.Text
  optionsJson   Json
  correctAnswer String   @db.Text
  explanation   String   @db.Text
  order         Int      @map("order_index")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  challenge Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  answers   UserChallengeAnswer[]

  @@index([challengeId, order])
}

model UserChallengeAttempt {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  challengeId    String                 @db.Uuid
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  status         ChallengeAttemptStatus @default(IN_PROGRESS)
  score          Float                  @default(0)
  correctCount   Int                    @default(0)
  incorrectCount Int                    @default(0)
  earnedXp       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  answers   UserChallengeAnswer[]

  @@index([userId, startedAt])
  @@index([challengeId, status])
}

model UserChallengeAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  attemptId      String   @db.Uuid
  questionId     String   @db.Uuid
  selectedAnswer String   @db.Text
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  attempt  UserChallengeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ChallengeQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, answeredAt])
}

model LearningQuizSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @db.Uuid
  mode                LearningQuizMode
  questionCount       Int
  selectedDeckScope   LearningDeckScope
  selectedCardIdsJson Json?
  orientationScope    LearningOrientationScope
  startedAt           DateTime                 @default(now())
  finishedAt          DateTime?
  totalCorrect        Int                      @default(0)
  totalIncorrect      Int                      @default(0)
  scorePercent        Float                    @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions LearningQuizQuestion[]

  @@index([userId])
  @@index([startedAt])
  @@index([finishedAt])
}

model LearningQuizQuestion {
  id             String                   @id @default(uuid()) @db.Uuid
  sessionId      String                   @db.Uuid
  cardId         String
  orientation    CardOrientation
  questionType   LearningQuizQuestionType
  promptText     String                   @db.Text
  correctAnswer  String                   @db.Text
  optionsJson    Json
  selectedAnswer String?                  @db.Text
  isCorrect      Boolean?
  answeredAt     DateTime?
  order          Int                      @map("order_index")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  session LearningQuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([cardId, orientation])
  @@index([order])
}

model CardLearningProgress {
  id                     String          @id @default(uuid()) @db.Uuid
  userId                 String          @db.Uuid
  cardId                 String
  orientation            CardOrientation
  correctCount           Int             @default(0)
  incorrectCount         Int             @default(0)
  currentCorrectStreak   Int             @default(0)
  currentIncorrectStreak Int             @default(0)
  bestCorrectStreak      Int             @default(0)
  masteryLevel           Int             @default(0)
  isMastered             Boolean         @default(false)
  weight                 Float           @default(1)
  lastSeenAt             DateTime?
  lastCorrectAt          DateTime?
  lastIncorrectAt        DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, orientation])
  @@index([userId])
  @@index([userId, orientation])
  @@index([isMastered, weight])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        PermissionCode   @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  plans       PlanPermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model BitacoraEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  spreadType  String
  question    String   @db.Text
  readingDate DateTime
  readingTime String?
  notes       String?  @db.Text
  cardsJson   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  reReadings BitacoraReReading[]

  @@index([userId])
  @@index([createdAt])
}

model BitacoraReReading {
  id                String   @id @default(uuid()) @db.Uuid
  bitacoraEntryId   String   @db.Uuid
  userId            String   @db.Uuid
  fulfilled         Boolean?
  comment           String?  @db.Text
  reflection        String?  @db.Text
  newInterpretation String?  @db.Text
  lessonLearned     String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bitacoraEntry BitacoraEntry @relation(fields: [bitacoraEntryId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bitacoraEntryId])
}

model Plan {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  price     Decimal    @default(0) @db.Decimal(10, 2)
  currency  String     @default("USD")
  type      PlanType   @default(FREE)
  status    PlanStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  permissions   PlanPermission[]
  limits        PlanLimit[]
  subscriptions UserSubscription[]
}

model PlanPermission {
  planId       String @db.Uuid
  permissionId String @db.Uuid

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([planId, permissionId])
}

model PlanLimit {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  code      String
  value     Int
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model UserSubscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  planId    String             @db.Uuid
  startDate DateTime           @default(now())
  endDate   DateTime?
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
}

model AccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  email     String
  action    String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum UsageType {
  AI
  READING
}

model UsageLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  type         UsageType
  planSnapshot PlanTier  @default(FREE)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([planSnapshot])
}

model CartaDelDia {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  cardId            String
  orientation       CardOrientation
  fechaLocal        String
  isRevealed        Boolean         @default(false)
  mensajeDia        String          @db.Text
  preguntaReflexion String          @db.Text
  createdAt         DateTime        @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflexion ReflexionCartaDia?

  @@unique([userId, fechaLocal])
  @@index([userId, fechaLocal])
}

model ReflexionCartaDia {
  id                     String   @id @default(uuid()) @db.Uuid
  cartaDelDiaId          String   @unique @db.Uuid
  userId                 String   @db.Uuid
  sintioEnergia          String
  textoReflexion         String   @db.Text
  aprendizaje            String   @db.Text
  moodLevel              Int?
  porcentajeCoincidencia Int?
  analisisCoincidencia   String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  cartaDelDia CartaDelDia @relation(fields: [cartaDelDiaId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyJournalEntry {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @db.Uuid
  date             String
  cardId           String
  cardName         String
  orientation      CardOrientation
  cardImageUrl     String
  dailyMessage     String             @db.Text
  morningIntention String?            @db.Text
  experience       String?            @db.Text
  manifestedAreas  String[]
  intensity        Int?
  nightReflection  String?            @db.Text
  status           DailyJournalStatus @default(EMPTY)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
